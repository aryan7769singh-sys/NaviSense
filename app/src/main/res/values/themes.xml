<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the whole UI, so this theme only needs to give the Activity a
      window with no action bar. Material3's XML themes come from the View-based
      library, which a Compose-only app does not depend on.
    -->
    <style name="Theme.IDR" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
